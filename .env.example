# Configuration normally lives in ~/.config/leantime/ — see `leantmcp key set`
# and `leantmcp url set <url>`. Set the variables below ONLY to override for a
# specific run (e.g. running the e2e suite against the local docker instance:
# `LEANTIME_URL=http://localhost:8090 LEANTIME_API_KEY=lt_local... deno task dev`).

#LEANTIME_URL=http://localhost:8090
#LEANTIME_API_KEY=lt_local_instance_key

# Destructive operations policy for delete tools (ticket, milestone, comment,
# timesheet entry): ask (default — requires confirm: true after explicit user
# approval), deny (refuse even with confirm), allow (skip confirmation).
#LEANTIME_MCP_DESTRUCTIVE_POLICY=ask
