{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false
  },
  "imports": {
    "@mcp/server": "npm:@modelcontextprotocol/sdk/server/mcp.js",
    "@mcp/stdio": "npm:@modelcontextprotocol/sdk/server/stdio.js",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "zod": "npm:zod@^3"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "build": "deno compile --allow-net --allow-env --allow-read --allow-write --output leantmcp src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "test:unit": "deno test --allow-net --allow-env --allow-read --allow-write tests/unit/",
    "test:integration": "deno test --allow-net --allow-env --allow-read --allow-write tests/integration/",
    "test:e2e": "deno test --env --allow-net --allow-env --allow-read --allow-write tests/e2e/"
  }
}
